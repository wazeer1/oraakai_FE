VITE_BASE_URL="http://localhost:8000/api/v1/"

# Public OAuth client IDs only. NEVER put client *secrets* here — every
# VITE_-prefixed var is inlined into the shipped JS bundle and readable by
# anyone who opens dev tools. Secrets live only in the backend's .env
# (GOOGLE_CLIENT_SECRET / GITHUB_CLIENT_SECRET) and are used exclusively
# server-side during the authorization-code exchange.
VITE_GOOGLE_CLIENT_ID=13288384332-96gehorusfoelhffbbm9kccv9aff74ho.apps.googleusercontent.com
VITE_GITHUB_CLIENT_ID=Ov23lilhSz1UjH7erodK

# Must exactly match the redirect URI registered in each provider's OAuth
# app settings, and the path OAuthCallbackPage is routed at.
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback/github

# /admin login gate. WARNING: like every VITE_-prefixed var, these are
# inlined into the shipped JS bundle in plain text — anyone who opens dev
# tools on the deployed site can read them directly, and the resulting
# "logged in" state is just client-side and can be forged from the
# console regardless of what's typed into the form. This is a UI
# convenience gate only, NOT real access control — see
# src/features/admin/adminAuth.ts.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=changeme123
